{
  "name": "flow-hijacked-android",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "export:web": "expo export --platform web",
    "prebuild": "expo prebuild --clean --platform android",
    "audit:16kb": "bash scripts/audit-16kb.sh",
    "audit:secrets": "bash scripts/secret-scan.sh",
    "audit:ask:production": "node scripts/audit-ask-production.mjs --live",
    "assets": "node scripts/generate-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run export:web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.90.20",
    "expo": "~57.0.11",
    "expo-build-properties": "~57.0.6",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.2",
    "expo-router": "~57.0.11",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.1",
    "expo-splash-screen": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|expo-modules-core|@expo(nent)?/.*|@expo/.*|expo-router|@shopify/react-native-skia|react-native-svg|react-native-reanimated)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/test/**"
    ]
  }
}
